# AdZero 社区桥 .htaccess
# 需要 Apache + mod_rewrite（InfinityFree 已支持）

DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 反馈队列与配置禁止直接访问
  RewriteRule ^pending/ - [F,L]
</IfModule>

<FilesMatch "^(config|config\.sample|lib)\.php$">
  Require all denied
</FilesMatch>

# 规则文件允许匿名 GET，给客户端留短缓存
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "max-age=300, public"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/plain
</IfModule>
