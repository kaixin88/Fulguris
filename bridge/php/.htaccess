# 社区桥 .htaccess - 保护敏感文件与目录
# 需要 Apache + mod_rewrite；nginx 用户请参考 README 等价配置。

# 禁止直接访问：配置（含密钥）、反馈队列
<FilesMatch "^(config\.php|config-sample\.php)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^pending/ - [F,L]

# 规则文件本身允许匿名 GET（客户端拉取），保留默认缓存策略
<FilesMatch "\.json$">
  Header set Cache-Control "max-age=300, public"
</FilesMatch>
